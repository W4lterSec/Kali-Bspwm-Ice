#!/usr/bin/env bash
# Kali Dragon Ice. Original r1vs3c sxhkd shortcuts are retained verbatim.
export DRAGON_ROOT="$HOME/.local/share/kali-dragon-ice"
if [[ $(systemd-detect-virt --vm 2>/dev/null) == oracle ]]; then
    export LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-1}"
fi
python3 "$DRAGON_ROOT/scripts/appearance.py" --render-only
while IFS= read -r monitor; do
    count=$(bspc query -D -m "$monitor" | wc -l)
    if [[ $count -le 1 ]]; then
        bspc monitor "$monitor" -d I II III IV V VI VII VIII
    fi
done < <(bspc query -M --names)
wmname LG3D
bspc config split_ratio 0.50
bspc config borderless_monocle true
bspc config gapless_monocle true
bspc config paddingless_monocle true
bspc config focus_follows_pointer true
bspc config pointer_modifier mod1
bspc config top_padding 0
bspc config normal_border_color '#305166'
bspc config focused_border_color '#25d9f8'
bspc config presel_feedback_color '#126a85'
source "$HOME/.config/kali-dragon-ice/geometry.sh"
bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
bash "$DRAGON_ROOT/scripts/session.sh"
