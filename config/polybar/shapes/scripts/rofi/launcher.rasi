configuration {
    font: "DejaVu Sans Mono 15";
    show-icons: false;
    display-drun: "Aplicaciones";
    drun-display-format: "{name}";
}
* {
    background-color: #08121a;
    text-color: #e7f4fa;
    border-color: #25d9f8;
}
window { width: 620px; border: 2px; border-radius: 20px; padding: 12px; }
mainbox { spacing: 8px; }
inputbar { children: [ prompt, entry ]; spacing: 8px; padding: 12px; }
prompt { text-color: #73e5ff; }
entry { placeholder: "Buscar..."; }
listview { lines: 7; scrollbar: false; spacing: 8px; }
element { padding: 12px; border-radius: 8px; }
element selected.normal { background-color: #126a85; text-color: #ffffff; }
element-text { background-color: inherit; text-color: inherit; }
